# Copy this file to .env and fill in your own values.
# Local dev only: GitHub Actions uses its own repo secrets, not this file.

# Home location used for the weather block and for deciding whether
# today's calendar implies travel somewhere else.
LOCATION_NAME=Paris
LAT=48.8566
LON=2.3522

# IANA timezone used to decide send time and format event times.
HOME_TIMEZONE=Europe/Paris

# Google Calendar ID to read events from. "primary" is your main calendar.
CALENDAR_ID=primary

# Number of unread emails to include in the briefing.
EMAIL_COUNT=5

# Telegram bot token from @BotFather, and the chat ID it should send to.
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Claude Code OAuth token, from running `claude setup-token` locally.
# Only needed to run tools/send_morning_briefing.py standalone, outside
# an interactive Claude Code session.
CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token
